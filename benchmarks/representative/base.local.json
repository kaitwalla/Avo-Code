    "max_turns": 24,
    "timeout_seconds": 1800
  },
  "planner": {
    "enabled": false
  },
  "supervisor": {
    "enabled": false
  },
  "team": {
    "enabled": false
  },
  "evaluators": [
    {
      "name": "visible",
      "command": "python visible_test.py",
      "weight": 1.0
    }
  ]
}

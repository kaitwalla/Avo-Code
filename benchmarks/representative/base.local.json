{
  "repo": ".",
  "state_dir": ".state",
  "max_iterations": 3,
  "acceptance_score": 1.0,
  "cloud_assist_budget": 0,
  "worker": {
    "backend": "nemo",
    "adapter_id": "nvidia.fabric.hermes",
    "provider": "openai",
    "model": "local-coder",
    "base_url": "http://127.0.0.1:8000/v1",
